{
  "name": "Plate Passport",
  "short_name": "Plate Passport",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F1F3EF",
  "theme_color": "#F1F3EF",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "photo",
          "accept": [
            "image/*",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  }
}
